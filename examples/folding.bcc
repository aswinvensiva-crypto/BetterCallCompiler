// What the optimiser can and cannot decide.
//
// `2 * 3 + 4` folds to 10 before the VM ever sees it, and the branch below
// folds too — dead-code elimination then removes the arm nobody can reach.
// `divide` is left alone: its operands are unknown until it is called, and
// division by zero is the VM's decision rather than the folder's.

fn divide(a: int, b: int) -> int {
  return a / b;
}

print 2 * 3 + 4;

if 1 < 2 {
  print 100;
} else {
  print 200;
}

print divide(9, 2);
