{
  "name": "bettercallcompiler",
  "version": "0.1.0",
  "description": "BetterCallCompiler — a native IDE with transparent AI and zero-install runtimes",
  "private": true,
  "license": "MIT",
  "author": "BetterCallCompiler",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:asar": "node test/asar/run-matrix.mjs",
    "test:query": "node test/query/run-cutoff-proof.mjs",
    "test:lang": "node test/lang/run-lang-proof.mjs",
    "test:gc": "node test/gc/run-gc-control.mjs",
    "rebuild": "electron-rebuild",
    "build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "build:unpacked": "npm run build && electron-builder --win --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@octokit/graphql": "9.0.3",
    "@octokit/rest": "22.0.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "5.0.0",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0",
    "simple-git": "3.36.0",
    "typescript": "5.9.3",
    "web-tree-sitter": "^0.26.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.62.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "24.13.3",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
